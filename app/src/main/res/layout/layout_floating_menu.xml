<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_bubble_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_bubble"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Stop Button (Kết thúc) -->
    <ImageButton
        android:id="@+id/btn_stop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_round_badge"
        android:contentDescription="@string/stop_recording"
        android:src="@android:drawable/ic_media_pause"
        app:tint="@color/white" />

    <!-- Pause/Resume Button (Tạm dừng/Tiếp tục) -->
    <ImageButton
        android:id="@+id/btn_pause_resume"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/pause_recording"
        android:src="@android:drawable/ic_media_play"
        app:tint="@color/white" />

    <!-- Brush Button (Cọ vẽ) -->
    <ImageButton
        android:id="@+id/btn_brush"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Cọ vẽ ghi chú"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="#FFD700" />

    <!-- Facecam Button (Camera trước) -->
    <ImageButton
        android:id="@+id/btn_facecam"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Camera trước"
        android:src="@android:drawable/ic_menu_camera"
        app:tint="@color/white" />

</LinearLayout>
